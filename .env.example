# =============================================================================
# N5GEH API Protection - Environment configuration
#
# Copy this file to `.env` and adjust the values to your environment:
#   cp .env.example .env
#
# All variables are read by `api_protection.yaml` and `platform_v2.yaml`.
# Values shown below are the defaults; remove a variable to fall back to the
# built-in default defined in the compose files.
# =============================================================================

# -----------------------------------------------------------------------------
# Common / networking
# -----------------------------------------------------------------------------
# Hostname / IP used to reach Keycloak and Kong from the outside.
# NOTE: use the reachable IP of your machine (not localhost) when accessing
# Keycloak from containers or remote clients.
KEYCLOAK_HOSTNAME=127.0.0.1
TIMEZONE=Europe/Berlin

# -----------------------------------------------------------------------------
# API protection framework (api_protection.yaml)
# -----------------------------------------------------------------------------

# Kong database (PostgreSQL)
KONG_DB_PORT=15432
KONG_DB_NAME=api-gw
KONG_DB_USER=kong
KONG_DB_PASSWORD=kong

# Kong proxy / admin listeners
KONG_PROXY_PORT=8000
KONG_PROXY_SSL_PORT=8443
KONG_ADMIN_PORT=8001
KONG_ADMIN_SSL_PORT=8444

# User under which the Kong container runs
KONG_USER=kong

# Konga web UI
KONGA_PORT=1337

# Keycloak database (PostgreSQL)
KEYCLOAK_DB_PORT=25432
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=password

# Keycloak admin bootstrap credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak listener ports
KEYCLOAK_HTTP_PORT=8180
KEYCLOAK_HTTPS_PORT=8543

# Keycloak hostname policy.
# Set both to "false" for a local tutorial setup; tighten for production.
KEYCLOAK_HOSTNAME_STRICT=false
KEYCLOAK_HOSTNAME_STRICT_HTTPS=false

# Keycloak realm file to import on startup (mounted read-only)
KEYCLOAK_REALM_IMPORT=./keycloak/realm/kong-realm.json

# -----------------------------------------------------------------------------
# Platform (platform_v2.yaml)
# -----------------------------------------------------------------------------

# Component versions
ORION_VERSION=3.7.0
MONGODB_VERSION=5.0.24
ME_VERSION=1.0.2
IOTA_JSON_VERSION=1.19.0
EMQX_VERSION=5.8.8
QL_VERSION=1.0.0
CRATEDB_VERSION=4.8.4
GRAFANA_VERSION=9.3.0

# Ports
ORION_PORT=1026
ME_PORT=8081
IOTA_JSON_PORT=4041
IOTA_JSON_HTTP_PORT=7896
EMQX_PORT=1883
EMQX_GUI_PORT=18083
QL_PORT=8668
CRATEDB_PORT=4200
GRAFANA_PORT=3000

# -----------------------------------------------------------------------------
# Tests (tests/)
# -----------------------------------------------------------------------------
# Base URLs used by the pytest suite. Defaults are derived from the ports above
# when left unset.
KONG_ADMIN_URL=https://127.0.0.1:8444
KONG_PROXY_URL=https://127.0.0.1:8443
KEYCLOAK_URL=https://127.0.0.1:8543
KEYCLOAK_REALM=kong
TEST_CLIENT_ID=app
TEST_TENANT=ebcdev1
